{
  "schemaVersion": 1,
  "id": "kpedroc.desktop-glance",
  "name": "Desktop Glance",
  "version": "1.0.0",
  "author": "KPedroC",
  "license": "MIT",
  "description": "Desktop widgets with Spotify, calendar, weather and GitHub, plus a Spotify bar widget",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Desktop.qml",
    "barWidget": "SpotifyBar.qml"
  },
  "barWidget": {
    "displayName": "Spotify",
    "description": "Now playing; click to show/hide the Spotify window",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "maxChars": 30
    },
    "schema": [
      {
        "key": "maxChars",
        "type": "integer",
        "label": "Max title length",
        "min": 0,
        "max": 80,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}
