#!/usr/bin/python3
"""Fetch GitHub Actions runs for the workflows listed in
~/.config/omarchy/desktop-glance/github, plus your open pull requests with their
latest reviews/comments and unread state, and write them to ~/.cache/omarchy/desktop-glance/github.json. Uses the
gh CLI's login.

Desktop notifications: a tracked run finishing (per the line's notify
setting: mine / all / none) and new reviews or comments on your PRs.
"""

import json
import os
import re
import statistics
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

CONFIG = Path.home() / ".config/omarchy/desktop-glance/github"
OUTPUT = Path.home() / ".cache/omarchy/desktop-glance/github.json"
STATE = Path.home() / ".local/state/omarchy/desktop-glance/github-state.json"
RECENT = timedelta(hours=24)
MAX_RUNS = 6


def read_config():
    rules = []
    for line in CONFIG.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[1] in ("mine", "all", "none"):
            rules.append({"repo": parts[0], "notify": parts[1], "pattern": re.compile(parts[2])})
    return rules


def gh_api(path):
    result = subprocess.run(["gh", "api", "--method", "GET", path], capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "gh api failed")
    return json.loads(result.stdout)


PULLS_QUERY = """
query {
  mine: search(query: "is:pr is:open author:@me archived:false sort:updated-desc", type: ISSUE, first: 15) {
    nodes { ... on PullRequest { id number title url isDraft createdAt updatedAt reviewDecision mergeable
      repository { nameWithOwner }
      commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
      timelineItems(last: 10, itemTypes: [PULL_REQUEST_REVIEW, ISSUE_COMMENT]) { nodes { __typename
        ... on PullRequestReview { id state submittedAt author { login __typename } }
        ... on IssueComment { id createdAt author { login __typename } } } } } }
  }
}
"""

EVENT_VERBS = {"APPROVED": "approved", "CHANGES_REQUESTED": "requested changes", "COMMENTED": "reviewed", "COMMENT": "commented"}
# Unread notification reasons that mean someone did something on your PR.
ACTIVITY_REASONS = {"author", "comment", "mention", "state_change", "manual", "subscribed"}


def unread_pull_keys():
    """(repo, number) of your PRs with unread activity notifications."""
    result = subprocess.run(["gh", "api", "--method", "GET", "notifications?per_page=100"], capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        return set()
    keys = set()
    for n in json.loads(result.stdout):
        subject = n.get("subject") or {}
        if subject.get("type") == "PullRequest" and n.get("reason") in ACTIVITY_REASONS and subject.get("url"):
            keys.add((n["repository"]["full_name"], int(subject["url"].rsplit("/", 1)[-1])))
    return keys


def fetch_pulls(me):
    result = subprocess.run(["gh", "api", "graphql", "-f", f"query={PULLS_QUERY}"],
                            capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "gh api graphql failed")
    nodes = json.loads(result.stdout)["data"]["mine"]["nodes"]
    unread = unread_pull_keys()

    mine = []
    for n in nodes:
        if not n:
            continue
        commits = n.get("commits", {}).get("nodes") or []
        rollup = commits[0]["commit"].get("statusCheckRollup") if commits else None
        # Reviews and comments by people other than you (bots ignored).
        events = []
        for item in (n.get("timelineItems") or {}).get("nodes") or []:
            author = item.get("author") or {}
            if not author or author.get("__typename") == "Bot" or author.get("login") == me:
                continue
            kind = item.get("state") if item["__typename"] == "PullRequestReview" else "COMMENT"
            if kind not in EVENT_VERBS:
                continue
            events.append({"id": item["id"], "author": author["login"], "kind": kind,
                           "verb": EVENT_VERBS[kind], "at": item.get("submittedAt") or item.get("createdAt")})
        repo = n["repository"]["nameWithOwner"]
        mine.append({
            "id": n["id"],
            "repo": repo,
            "number": n["number"],
            "title": n["title"],
            "url": n["url"],
            "draft": n["isDraft"],
            "createdAt": n["createdAt"],
            "updatedAt": n["updatedAt"],
            "review": n.get("reviewDecision"),
            "checks": (rollup or {}).get("state"),
            "conflicts": n.get("mergeable") == "CONFLICTING",
            "lastEvent": events[-1] if events else None,
            "events": events,
            "unread": (repo, n["number"]) in unread,
        })
    for pr in mine:
        pr["ready"] = (not pr["draft"] and pr["review"] == "APPROVED"
                       and pr["checks"] in ("SUCCESS", None) and not pr["conflicts"])

    # What needs you first: unread activity, ready to merge, changes
    # requested, the rest; drafts last; most recent activity within each.
    def rank(pr):
        if pr["draft"]:
            return 4
        if pr["unread"]:
            return 0
        if pr["ready"]:
            return 1
        return 2 if pr["review"] == "CHANGES_REQUESTED" else 3

    mine.sort(key=lambda p: (p["lastEvent"] or {}).get("at") or p["updatedAt"], reverse=True)
    mine.sort(key=rank)
    return {"mine": mine}


def notify_text(title, body):
    subprocess.run(["notify-send", "-a", "GitHub", "--", title, body], check=False)


def parse_time(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00")) if value else None


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as tmp:
        json.dump(data, tmp)
    os.replace(tmp.name, path)


def notify(run):
    passed = run["conclusion"] == "success"
    icon = "✓" if passed else "✗"
    verb = "passed" if passed else (run["conclusion"] or "finished")
    subprocess.run(["notify-send", "-a", "GitHub", "--", f"{icon} {run['workflow']} {verb}",
                    f"{run['title']}\n{run['repo']} · {run['branch']}"], check=False)


def main():
    rules = read_config()
    me = gh_api("user")["login"]
    now = datetime.now(timezone.utc)
    runs, errors = [], []

    for repo in sorted({r["repo"] for r in rules}):
        repo_rules = [r for r in rules if r["repo"] == repo]
        try:
            data = gh_api(f"/repos/{repo}/actions/runs?per_page=60")
        except Exception as error:
            errors.append({"repo": repo, "error": str(error)})
            continue

        # Typical duration per workflow, from its recent successful runs.
        durations = {}
        for item in data.get("workflow_runs", []):
            if item.get("conclusion") == "success":
                started, ended = parse_time(item.get("run_started_at")), parse_time(item.get("updated_at"))
                if started and ended:
                    durations.setdefault(item["name"], []).append((ended - started).total_seconds())

        for item in data.get("workflow_runs", []):
            rule = next((r for r in repo_rules if r["pattern"].search(item["name"])), None)
            if not rule:
                continue
            started = parse_time(item.get("run_started_at") or item.get("created_at"))
            ended = parse_time(item.get("updated_at"))
            running = item["status"] != "completed"
            if not running and (not ended or now - ended > RECENT):
                continue
            actors = {(item.get("actor") or {}).get("login"), (item.get("triggering_actor") or {}).get("login")}
            typical = durations.get(item["name"])
            runs.append({
                "id": item["id"],
                "repo": repo,
                "workflow": item["name"],
                "title": item.get("display_title", ""),
                "branch": item.get("head_branch") or "",
                "url": item["html_url"],
                "status": item["status"],
                "conclusion": item.get("conclusion"),
                "startedAt": started.isoformat() if started else None,
                "endedAt": None if running else ended.isoformat(),
                "typicalSeconds": int(statistics.median(typical[:10])) if typical else None,
                "mine": me in actors,
                "notify": rule["notify"],
            })

    running = [r for r in runs if r["status"] != "completed"]
    finished = sorted([r for r in runs if r["status"] == "completed"], key=lambda r: r["endedAt"], reverse=True)
    runs = (running + finished)[:MAX_RUNS]

    try:
        pulls = fetch_pulls(me)
    except Exception as error:
        errors.append({"repo": "pull requests", "error": str(error)})
        pulls = None

    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}

    # Runs that were running last sync and have finished since.
    previous = set(state.get("running", []))
    for run in finished:
        if run["id"] in previous and (run["notify"] == "all" or (run["notify"] == "mine" and run["mine"])):
            notify(run)
    state["running"] = [r["id"] for r in running]

    # New reviews/comments on your PRs since last sync; the first sync only
    # records what's there.
    if pulls is not None:
        seen = state.get("events")
        current = {e["id"] for pr in pulls["mine"] for e in pr["events"]}
        if seen is not None:
            for pr in pulls["mine"]:
                for e in pr["events"]:
                    if e["id"] not in seen:
                        icon = {"APPROVED": "✓", "CHANGES_REQUESTED": "✗"}.get(e["kind"], "󰅺")
                        notify_text(f"{icon} {e['author']} {e['verb']}", f"{pr['title']}\n{pr['repo']} #{pr['number']}")
        state["events"] = sorted(current | set(seen or []))[-500:]
        state.pop("reviews", None)
        state.pop("decisions", None)
    write_json(STATE, state)

    payload = {"updatedAt": now.isoformat(), "errors": errors, "runs": runs, "anyRunning": bool(running)}
    if pulls is not None:
        payload["pulls"] = pulls
    elif OUTPUT.exists():
        try:
            payload["pulls"] = json.loads(OUTPUT.read_text()).get("pulls")
        except ValueError:
            pass
    write_json(OUTPUT, payload)
    print(f"{len(running)} running, {len(finished)} recent, "
          f"{len(pulls['mine']) if pulls else '?'} open PRs, {len(errors)} errors")
    return 0


if __name__ == "__main__":
    sys.exit(main())
