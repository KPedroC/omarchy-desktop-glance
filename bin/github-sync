#!/usr/bin/python3
"""Fetch GitHub Actions runs for the workflows listed in
~/.config/omarchy/desk-github, plus open pull requests that need your review
and your own, and write them to ~/.cache/omarchy-desk/github.json. Uses the
gh CLI's login.

Desktop notifications: a tracked run finishing (per the line's notify
setting: mine / all / none), a new review request, and your PR getting
approved or changes requested.
"""

import json
import os
import re
import statistics
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

CONFIG = Path.home() / ".config/omarchy/desk-github"
OUTPUT = Path.home() / ".cache/omarchy-desk/github.json"
STATE = Path.home() / ".cache/omarchy-desk/github-state.json"
RECENT = timedelta(hours=24)
MAX_RUNS = 6


def read_config():
    rules = []
    for line in CONFIG.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[1] in ("mine", "all", "none"):
            rules.append({"repo": parts[0], "notify": parts[1], "pattern": re.compile(parts[2])})
    return rules


def gh_api(path):
    result = subprocess.run(["gh", "api", path], capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "gh api failed")
    return json.loads(result.stdout)


PULLS_QUERY = """
query {
  review: search(query: "is:pr is:open review-requested:@me archived:false", type: ISSUE, first: 15) {
    nodes { ... on PullRequest { id number title url isDraft createdAt updatedAt
      repository { nameWithOwner } author { login } } }
  }
  mine: search(query: "is:pr is:open author:@me archived:false sort:updated-desc", type: ISSUE, first: 15) {
    nodes { ... on PullRequest { id number title url isDraft createdAt updatedAt reviewDecision
      repository { nameWithOwner }
      commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } }
  }
}
"""


def fetch_pulls():
    result = subprocess.run(["gh", "api", "graphql", "-f", f"query={PULLS_QUERY}"],
                            capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "gh api graphql failed")
    data = json.loads(result.stdout)["data"]

    def base(node):
        return {
            "id": node["id"],
            "repo": node["repository"]["nameWithOwner"],
            "number": node["number"],
            "title": node["title"],
            "url": node["url"],
            "draft": node["isDraft"],
            "createdAt": node["createdAt"],
            "updatedAt": node["updatedAt"],
        }

    review = [dict(base(n), author=(n.get("author") or {}).get("login", "")) for n in data["review"]["nodes"] if n]
    mine = []
    for n in data["mine"]["nodes"]:
        if not n:
            continue
        commits = n.get("commits", {}).get("nodes") or []
        rollup = commits[0]["commit"].get("statusCheckRollup") if commits else None
        mine.append(dict(base(n), review=n.get("reviewDecision"), checks=(rollup or {}).get("state")))
    # Ready PRs before drafts, most recently updated first within each.
    mine.sort(key=lambda p: p["updatedAt"], reverse=True)
    mine.sort(key=lambda p: p["draft"])
    return {"review": review, "mine": mine}


def notify_text(title, body):
    subprocess.run(["notify-send", "-a", "GitHub", title, body], check=False)


def parse_time(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00")) if value else None


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as tmp:
        json.dump(data, tmp)
    os.replace(tmp.name, path)


def notify(run):
    passed = run["conclusion"] == "success"
    icon = "✓" if passed else "✗"
    verb = "passed" if passed else (run["conclusion"] or "finished")
    subprocess.run(["notify-send", "-a", "GitHub", f"{icon} {run['workflow']} {verb}",
                    f"{run['title']}\n{run['repo']} · {run['branch']}"], check=False)


def main():
    rules = read_config()
    me = gh_api("user")["login"]
    now = datetime.now(timezone.utc)
    runs, errors = [], []

    for repo in sorted({r["repo"] for r in rules}):
        repo_rules = [r for r in rules if r["repo"] == repo]
        try:
            data = gh_api(f"/repos/{repo}/actions/runs?per_page=60")
        except Exception as error:
            errors.append({"repo": repo, "error": str(error)})
            continue

        # Typical duration per workflow, from its recent successful runs.
        durations = {}
        for item in data.get("workflow_runs", []):
            if item.get("conclusion") == "success":
                started, ended = parse_time(item.get("run_started_at")), parse_time(item.get("updated_at"))
                if started and ended:
                    durations.setdefault(item["name"], []).append((ended - started).total_seconds())

        for item in data.get("workflow_runs", []):
            rule = next((r for r in repo_rules if r["pattern"].search(item["name"])), None)
            if not rule:
                continue
            started = parse_time(item.get("run_started_at") or item.get("created_at"))
            ended = parse_time(item.get("updated_at"))
            running = item["status"] != "completed"
            if not running and (not ended or now - ended > RECENT):
                continue
            actors = {(item.get("actor") or {}).get("login"), (item.get("triggering_actor") or {}).get("login")}
            typical = durations.get(item["name"])
            runs.append({
                "id": item["id"],
                "repo": repo,
                "workflow": item["name"],
                "title": item.get("display_title", ""),
                "branch": item.get("head_branch") or "",
                "url": item["html_url"],
                "status": item["status"],
                "conclusion": item.get("conclusion"),
                "startedAt": started.isoformat() if started else None,
                "endedAt": None if running else ended.isoformat(),
                "typicalSeconds": int(statistics.median(typical[:10])) if typical else None,
                "mine": me in actors,
                "notify": rule["notify"],
            })

    running = [r for r in runs if r["status"] != "completed"]
    finished = sorted([r for r in runs if r["status"] == "completed"], key=lambda r: r["endedAt"], reverse=True)
    runs = (running + finished)[:MAX_RUNS]

    try:
        pulls = fetch_pulls()
    except Exception as error:
        errors.append({"repo": "pull requests", "error": str(error)})
        pulls = None

    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}

    # Runs that were running last sync and have finished since.
    previous = set(state.get("running", []))
    for run in finished:
        if run["id"] in previous and (run["notify"] == "all" or (run["notify"] == "mine" and run["mine"])):
            notify(run)
    state["running"] = [r["id"] for r in running]

    # PR changes since last sync; the first sync only records state.
    if pulls is not None:
        known_reviews = state.get("reviews")
        decisions = state.get("decisions")
        if known_reviews is not None:
            for pr in pulls["review"]:
                if pr["id"] not in known_reviews:
                    notify_text("󰳏 Review requested", f"{pr['title']}\n{pr['repo']} #{pr['number']} · {pr['author']}")
        if decisions is not None:
            for pr in pulls["mine"]:
                before, after = decisions.get(pr["id"]), pr["review"]
                if after != before and after in ("APPROVED", "CHANGES_REQUESTED"):
                    label = "✓ PR approved" if after == "APPROVED" else "✗ Changes requested"
                    notify_text(label, f"{pr['title']}\n{pr['repo']} #{pr['number']}")
        state["reviews"] = [pr["id"] for pr in pulls["review"]]
        state["decisions"] = {pr["id"]: pr["review"] for pr in pulls["mine"]}
    write_json(STATE, state)

    payload = {"updatedAt": now.isoformat(), "errors": errors, "runs": runs, "anyRunning": bool(running)}
    if pulls is not None:
        payload["pulls"] = pulls
    elif OUTPUT.exists():
        try:
            payload["pulls"] = json.loads(OUTPUT.read_text()).get("pulls")
        except ValueError:
            pass
    write_json(OUTPUT, payload)
    print(f"{len(running)} running, {len(finished)} recent, "
          f"{len(pulls['review']) if pulls else '?'} to review, {len(pulls['mine']) if pulls else '?'} mine, {len(errors)} errors")
    return 0


if __name__ == "__main__":
    sys.exit(main())
