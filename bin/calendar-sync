#!/usr/bin/python3
"""Fetch the calendars in ~/.config/omarchy/desk-calendars and write events
from the start of this month's calendar grid to two months ahead to
~/.cache/omarchy-desk/events.json.

Sources are iCal feed URLs, or `google:<calendar id>` read through the
Google Calendar API with OAuth.

  calendar-sync           sync (Google calendars at most every 15 minutes)
  calendar-sync --force   sync everything now
  calendar-sync --login   authorize Google Calendar access (opens the browser)
  calendar-sync --list    list Google calendars and their ids

Feed URLs and tokens are secrets: they are never printed, logged or written
outside their files.
"""

import base64
import hashlib
import http.server
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.error
import urllib.request
from datetime import date, datetime, time, timedelta
from pathlib import Path

import icalendar
import recurring_ical_events

CONFIG = Path.home() / ".config/omarchy/desk-calendars"
OUTPUT = Path.home() / ".cache/omarchy-desk/events.json"
GOOGLE_CLIENT = Path.home() / ".config/omarchy/desk-google-client.json"
GOOGLE_TOKEN = Path.home() / ".local/state/omarchy-desk/google-token.json"
GOOGLE_ACCESS = Path.home() / ".local/state/omarchy-desk/google-access.json"
GOOGLE_CACHE = Path.home() / ".cache/omarchy-desk/google-cache.json"
GOOGLE_INTERVAL = timedelta(minutes=15)
GOOGLE_SCOPE = "https://www.googleapis.com/auth/calendar.readonly"
DAYS_AHEAD = 62
MEETING_LINK = re.compile(r"https://(?:[\w-]+\.)?(?:meet\.google\.com|zoom\.us|teams\.microsoft\.com|teams\.live\.com)/[^\s\"<>\\]+")


def read_config():
    calendars = []
    for line in CONFIG.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 3 and parts[2].startswith(("http", "google:")):
            calendars.append({"label": parts[0], "color": parts[1], "url": parts[2]})
    return calendars


class FeedError(Exception):
    pass


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": "omarchy-desk"})
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            body = response.read()
            content_type = response.headers.get_content_type()
    except urllib.error.HTTPError as error:
        raise FeedError(f"HTTP {error.code}") from None
    except urllib.error.URLError as error:
        raise FeedError(f"network: {type(error.reason).__name__}") from None
    if b"BEGIN:VCALENDAR" not in body[:1024]:
        raise FeedError(f"not an iCal feed ({content_type})")
    return body


def write_private(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as tmp:
        os.chmod(tmp.name, 0o600)
        json.dump(data, tmp)
    os.replace(tmp.name, path)


def google_client():
    if not GOOGLE_CLIENT.exists():
        raise FeedError(f"missing {GOOGLE_CLIENT.name}")
    data = json.loads(GOOGLE_CLIENT.read_text())
    return data.get("installed") or data.get("web") or data


def post_form(url, fields):
    body = urllib.parse.urlencode(fields).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=body), timeout=20) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        raise FeedError(f"token HTTP {error.code}") from None


def google_login():
    client = google_client()
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if query.get("state", [""])[0] == state:
                result.update({k: v[0] for k, v in query.items()})
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(b"<p>Done. You can close this tab.</p>")

        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    redirect = f"http://127.0.0.1:{server.server_port}"
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": client["client_id"],
        "redirect_uri": redirect,
        "response_type": "code",
        "scope": GOOGLE_SCOPE,
        "access_type": "offline",
        "prompt": "consent",
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
    })
    print("Opening the browser to authorize Google Calendar access…")
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    while "code" not in result and "error" not in result:
        server.handle_request()
    if "error" in result:
        print(f"Authorization failed: {result['error']}")
        return 1

    token = post_form("https://oauth2.googleapis.com/token", {
        "client_id": client["client_id"],
        "client_secret": client.get("client_secret", ""),
        "code": result["code"],
        "code_verifier": verifier,
        "grant_type": "authorization_code",
        "redirect_uri": redirect,
    })
    if "refresh_token" not in token:
        print("Authorization failed: no refresh token returned")
        return 1
    write_private(GOOGLE_TOKEN, {"refresh_token": token["refresh_token"]})
    print("Logged in. Run with --list to see your calendar ids.")
    return 0


_access_token = None


def google_access_token():
    global _access_token
    if _access_token:
        return _access_token
    # Access tokens last an hour; reuse one until shortly before it expires.
    try:
        cached = json.loads(GOOGLE_ACCESS.read_text())
        if datetime.fromisoformat(cached["expiresAt"]) > datetime.now().astimezone() + timedelta(minutes=2):
            _access_token = cached["accessToken"]
            return _access_token
    except (OSError, ValueError, KeyError):
        pass
    if not GOOGLE_TOKEN.exists():
        raise FeedError("not logged in (calendar-sync --login)")
    client = google_client()
    token = post_form("https://oauth2.googleapis.com/token", {
        "client_id": client["client_id"],
        "client_secret": client.get("client_secret", ""),
        "refresh_token": json.loads(GOOGLE_TOKEN.read_text())["refresh_token"],
        "grant_type": "refresh_token",
    })
    _access_token = token["access_token"]
    expires = datetime.now().astimezone() + timedelta(seconds=int(token.get("expires_in", 3600)))
    write_private(GOOGLE_ACCESS, {"accessToken": _access_token, "expiresAt": expires.isoformat()})
    return _access_token


def google_get(path, params):
    url = "https://www.googleapis.com/calendar/v3" + path + "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"Authorization": "Bearer " + google_access_token()})
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        raise FeedError(f"HTTP {error.code}") from None
    except urllib.error.URLError as error:
        raise FeedError(f"network: {type(error.reason).__name__}") from None


def google_list():
    for item in google_get("/users/me/calendarList", {}).get("items", []):
        print(f"google:{item['id']}    {item.get('summary', '')}")
    return 0


def google_meeting_link(item):
    if item.get("hangoutLink"):
        return item["hangoutLink"]
    for entry in item.get("conferenceData", {}).get("entryPoints", []):
        if entry.get("entryPointType") == "video":
            return entry.get("uri", "")
    for key in ("location", "description"):
        match = MEETING_LINK.search(item.get(key, ""))
        if match:
            return match.group(0)
    return ""


def load_google_cache():
    try:
        return json.loads(GOOGLE_CACHE.read_text())
    except (OSError, ValueError):
        return {}


# Google calendars are fetched at most every GOOGLE_INTERVAL; in between the
# last result is reused. Cache entries are keyed by calendar id and window start.
def cached_google_events(calendar, start, end, cache, force):
    key = f"{calendar['url']}|{start.date().isoformat()}"
    entry = cache.get(key)
    if entry and not force:
        fetched = datetime.fromisoformat(entry["fetchedAt"])
        if datetime.now().astimezone() - fetched < GOOGLE_INTERVAL:
            return [dict(e, calendar=calendar["label"], color=calendar["color"]) for e in entry["events"]]
    events = list(google_events(calendar, start, end))
    cache[key] = {"fetchedAt": datetime.now().astimezone().isoformat(), "events": events}
    return events


def google_events(calendar, start, end):
    calendar_id = calendar["url"][len("google:"):]
    params = {
        "timeMin": start.isoformat(),
        "timeMax": end.isoformat(),
        "singleEvents": "true",
        "orderBy": "startTime",
        "maxResults": "250",
    }
    items = []
    while True:
        data = google_get(f"/calendars/{urllib.parse.quote(calendar_id)}/events", params)
        items.extend(data.get("items", []))
        if not data.get("nextPageToken"):
            break
        params["pageToken"] = data["nextPageToken"]
    for item in items:
        if item.get("status") == "cancelled":
            continue
        if any(a.get("self") and a.get("responseStatus") == "declined" for a in item.get("attendees", [])):
            continue
        all_day = "date" in item["start"]
        if all_day:
            dtstart = date.fromisoformat(item["start"]["date"])
            dtend = date.fromisoformat(item["end"]["date"])
        else:
            dtstart = datetime.fromisoformat(item["start"]["dateTime"])
            dtend = datetime.fromisoformat(item["end"]["dateTime"])
        yield {
            "uid": item.get("iCalUID", item.get("id", "")),
            "title": item.get("summary", "").strip() or "(No title)",
            "start": as_datetime(dtstart).isoformat(),
            "end": as_datetime(dtend).isoformat(),
            "allDay": all_day,
            "location": item.get("location", "").strip(),
            "link": google_meeting_link(item),
            "calendar": calendar["label"],
            "color": calendar["color"],
        }


def as_datetime(value):
    if isinstance(value, datetime):
        return value.astimezone() if value.tzinfo else value.replace(tzinfo=datetime.now().astimezone().tzinfo)
    return datetime.combine(value, time.min).astimezone()


def meeting_link(event):
    for key in ("X-GOOGLE-CONFERENCE", "URL", "LOCATION", "DESCRIPTION"):
        match = MEETING_LINK.search(str(event.get(key, "")))
        if match:
            return match.group(0)
    return ""


def events_for(calendar, start, end, cache, force):
    if calendar["url"].startswith("google:"):
        yield from cached_google_events(calendar, start, end, cache, force)
        return
    ical = icalendar.Calendar.from_ical(fetch(calendar["url"]))
    for event in recurring_ical_events.of(ical).between(start, end):
        if str(event.get("STATUS", "")).upper() == "CANCELLED":
            continue
        dtstart = event.get("DTSTART").dt
        dtend = event.get("DTEND").dt if event.get("DTEND") else dtstart
        all_day = not isinstance(dtstart, datetime)
        yield {
            "uid": str(event.get("UID", "")),
            "title": str(event.get("SUMMARY", "")).strip() or "(No title)",
            "start": as_datetime(dtstart).isoformat(),
            "end": as_datetime(dtend).isoformat(),
            "allDay": all_day,
            "location": str(event.get("LOCATION", "")).strip(),
            "link": meeting_link(event),
            "calendar": calendar["label"],
            "color": calendar["color"],
        }


def main():
    if "--login" in sys.argv:
        return google_login()
    if "--list" in sys.argv:
        return google_list()

    force = "--force" in sys.argv
    # Covers the leading days of the current month's grid (Monday first).
    first = date.today().replace(day=1)
    start = datetime.combine(first - timedelta(days=first.weekday()), time.min).astimezone()
    end = datetime.combine(date.today() + timedelta(days=DAYS_AHEAD), time.min).astimezone()
    events, seen, errors = [], set(), []
    calendars = read_config()
    cache = load_google_cache()
    live_keys = {f"{c['url']}|{start.date().isoformat()}" for c in calendars if c["url"].startswith("google:")}

    for calendar in calendars:
        try:
            for event in events_for(calendar, start, end, cache, force):
                key = (event["uid"], event["start"]) if event["uid"] else (event["title"], event["start"])
                if key in seen:
                    continue
                seen.add(key)
                events.append(event)
        except FeedError as error:
            errors.append({"calendar": calendar["label"], "error": str(error)})
        except Exception as error:
            # Only the label and error type: messages can contain the URL.
            errors.append({"calendar": calendar["label"], "error": type(error).__name__})

    if live_keys or cache:
        write_private(GOOGLE_CACHE, {k: v for k, v in cache.items() if k in live_keys})

    events.sort(key=lambda e: (e["start"], not e["allDay"]))
    for event in events:
        event.pop("uid", None)

    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    payload = {"updatedAt": datetime.now().astimezone().isoformat(), "errors": errors, "events": events}
    with tempfile.NamedTemporaryFile("w", dir=OUTPUT.parent, delete=False) as tmp:
        json.dump(payload, tmp)
    os.replace(tmp.name, OUTPUT)
    print(f"{len(events)} events, {len(errors)} errors")
    return 0


if __name__ == "__main__":
    sys.exit(main())
